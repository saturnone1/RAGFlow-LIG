# 이 파일을 .env.secret으로 복사하고 Git에는 포함하지 마십시오.
PADDLEOCR_INTERNAL_TOKEN=replace-with-a-random-internal-token
PADDLEOCR_VL_INTERNAL_TOKEN=replace-with-a-separate-random-internal-token
# 최초 config/start 또는 에어갭 반입 때 자동 생성됩니다. 재시작 후에도 저장된
# 문서 암호를 복호화할 수 있도록 이 값을 변경하지 말고 안전하게 보관하십시오.
LIG_DOCUMENT_PASSWORD_KEY=generate-a-base64-encoded-32-byte-key
LIG_DOCUMENT_PASSWORD_KEY_ID=primary
# 키를 회전할 때 모든 레코드의 재암호화가 끝날 때까지 이전 키를
# key-id:base64,key-id:base64 형식으로 보관하십시오.
LIG_DOCUMENT_PASSWORD_PREVIOUS_KEYS=
