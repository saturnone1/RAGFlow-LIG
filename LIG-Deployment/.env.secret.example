# Copy to .env.secret and keep it out of Git.
RAGFLOW_MCP_API_KEY=ragflow-replace-with-a-local-api-key
PADDLEOCR_INTERNAL_TOKEN=replace-with-a-random-internal-token
# Generated automatically on first config/start or air-gap import. Keep this
# value stable so saved document passwords remain decryptable after restarts.
LIG_DOCUMENT_PASSWORD_KEY=generate-a-base64-encoded-32-byte-key
LIG_DOCUMENT_PASSWORD_KEY_ID=primary
# During key rotation, keep old keys as key-id:base64,key-id:base64 until all records are rewrapped.
LIG_DOCUMENT_PASSWORD_PREVIOUS_KEYS=
