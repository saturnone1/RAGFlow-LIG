# LIG lightweight single-node profile for a 16 GB Windows laptop.
# Load after docker/.env so these values override the upstream defaults.
RAGFLOW_IMAGE=lig/ragflow-ui:v0.26.4-1
DOC_ENGINE=infinity
DEVICE=cpu
COMPOSE_PROFILES=infinity,cpu
TZ=Asia/Seoul

# Keep every published service on the local machine only.
SVR_WEB_HTTP_PORT=127.0.0.1:42200
SVR_HTTP_PORT=127.0.0.1:42201
ADMIN_SVR_HTTP_PORT=127.0.0.1:42202
SVR_MCP_PORT=127.0.0.1:42203
GO_ADMIN_PORT=127.0.0.1:42204
GO_HTTP_PORT=127.0.0.1:42205
RAGFLOW_MCP_LIG_PORT=127.0.0.1:42206
SVR_WEB_HTTPS_PORT=127.0.0.1:42207
EXPOSE_MYSQL_PORT=127.0.0.1:42208
MINIO_PORT=127.0.0.1:42209
MINIO_CONSOLE_PORT=127.0.0.1:42210
REDIS_PORT=127.0.0.1:42211
INFINITY_THRIFT_PORT=127.0.0.1:42212
INFINITY_HTTP_PORT=127.0.0.1:42213
INFINITY_PSQL_PORT=127.0.0.1:42214
OLLAMA_PORT=127.0.0.1:42215
RAGFLOW_MCP_LIG_IMAGE=lig/ragflow-mcp:v0.26.4-1
LIG_MCP_DATA_DIRECTORY=../../LIG-Deployment/mcp-files
OLLAMA_IMAGE=ollama/ollama:0.32.0
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Avoid large concurrent parsing/embedding bursts on a laptop.
# Workers parallelize queued document tasks. They do not make every page of one
# large PDF run in parallel, and each worker can load parser models into memory.
TASK_EXECUTOR_WORKERS=2
DOC_BULK_SIZE=2
EMBEDDING_BATCH_SIZE=8
THREAD_POOL_MAX_WORKERS=12
USE_DOCLING=false
REGISTER_ENABLED=1
