# LIG 단일 노드 배포 설정입니다.
# upstream 기본값을 덮어쓰도록 docker/.env 다음에 불러옵니다.
RAGFLOW_IMAGE=lig/ragflow-ui:v0.26.4-4
RAGFLOW_GPU_IMAGE=lig/ragflow-ui-gpu:v0.26.4-4
DOC_ENGINE=infinity
DEVICE=cpu
COMPOSE_PROFILES=infinity,cpu
# LIG 문서 암호 및 OCR/청킹 안정화 기능은 Python API와 작업 실행기에서 동작합니다.
# upstream Go/하이브리드 모드도 명시적으로 선택할 수 있지만,
# 해당 모드에서는 LIG 확장 기능 전체를 보장하지 않습니다.
API_PROXY_SCHEME=python
TZ=Asia/Seoul

# 사내 다른 PC에서 접속할 사용자용 서비스만 모든 네트워크 인터페이스에
# 바인딩합니다. Windows 방화벽에서는 아래 사용자용 포트만 허용하십시오.
SVR_WEB_HTTP_PORT=0.0.0.0:42300
SVR_HTTP_PORT=0.0.0.0:42301
ADMIN_SVR_HTTP_PORT=127.0.0.1:42302
SVR_MCP_PORT=0.0.0.0:42303
GO_ADMIN_PORT=127.0.0.1:42304
GO_HTTP_PORT=127.0.0.1:42305
RAGFLOW_MCP_LIG_PORT=0.0.0.0:42306
SVR_WEB_HTTPS_PORT=0.0.0.0:42307
EXPOSE_MYSQL_PORT=127.0.0.1:42308
MINIO_PORT=127.0.0.1:42309
MINIO_CONSOLE_PORT=127.0.0.1:42310
REDIS_PORT=127.0.0.1:42311
INFINITY_THRIFT_PORT=127.0.0.1:42312
INFINITY_HTTP_PORT=127.0.0.1:42313
INFINITY_PSQL_PORT=127.0.0.1:42314
RAGFLOW_MCP_LIG_IMAGE=lig/ragflow-mcp:v0.26.4-3
LIG_MCP_DATA_DIRECTORY=../../LIG-Deployment/mcp-files
PADDLEOCR_IMAGE=lig/paddleocr-ko:v0.26.4-4
PADDLEOCR_PORT=127.0.0.1:42316
# 번들 내부 OCR은 비동기 Job API를 사용합니다. 사내 PaddleX endpoint를
# 모델/데이터셋 화면에서 등록할 때만 API 방식을 direct-image로 선택하십시오.
# direct-image의 기본 동시 페이지 요청 수이며 UI 저장값이 있으면 그 값이 우선합니다.
PADDLEOCR_API_MODE=job
PADDLEOCR_DIRECT_WORKERS=8
# 번들 Job API와 원격 PaddleX 이미지 API에서 사용할 PDF 페이지 렌더링 해상도입니다.
# MIL-STD-2525C의 144~300 DPI 비교에서 144 DPI가 평균 단어 F1이 가장 높고
# 300 DPI의 약 23% 픽셀만 사용했습니다. 작은 글자 누락 시 프로파일에서 216을 시험하십시오.
PADDLEOCR_DIRECT_RENDER_DPI=144
# CPU·GPU 설치 모두 일반 PP-OCRv5는 CPU ONNX Runtime을 사용합니다.
# GPU는 DeepDOC와 선택형 PaddleOCR-VL VLM에만 노출해 VRAM 경합을 줄입니다.
# PaddleOCR-VL-1.6은 선택 설치 항목입니다. 공식 오프라인 pipeline/vLLM
# 이미지와 RAGFlow 호환 게이트웨이를 사용하며 기존 OCR과 함께 등록됩니다.
PADDLEOCR_VL_ENABLED=true
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_VL_API_BASE_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-vl:latest-nvidia-gpu-offline
PADDLEOCR_VL_API_IMAGE=lig/paddleocr-vl-pipeline-cpu:1.6-1
PADDLEOCR_VL_VLM_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddleocr-genai-vllm-server:latest-nvidia-gpu-offline
PADDLEOCR_VL_VLM_RUNTIME_IMAGE=lig/paddleocr-vl-vlm:1.6-2
PADDLEOCR_VL_GATEWAY_IMAGE=lig/paddleocr-vl-gateway:1.6-1
PADDLEOCR_VL_PORT=127.0.0.1:42318
# 12 GiB GPU에서는 공식 vLLM 기본값(0.5, batched tokens 131072,
# API server 4)이 KV cache 블록을 만들지 못할 수 있습니다. eager 실행과
# 단일 API server를 사용하고, 레이아웃 검출은 CPU에서 실행해 VLM에 GPU를
# 집중합니다. GPU 여유가 확인된 경우에만 utilization을 조금씩 올리십시오.
PADDLEOCR_VL_GPU_MEMORY_UTILIZATION=0.60
PADDLEOCR_VL_MAX_MODEL_LEN=16384
PADDLEOCR_VL_MAX_NUM_BATCHED_TOKENS=16384
PADDLEOCR_VL_MAX_NUM_SEQS=8
PADDLEOCR_VL_API_SERVER_COUNT=1
PADDLEOCR_VL_PIPELINE_DEVICE=cpu
PADDLEOCR_VL_JOB_WORKERS=1
PADDLEOCR_VL_MAX_UPLOAD_BYTES=0
PADDLEOCR_VL_MAX_PENDING_JOBS=8
PADDLEOCR_VL_REQUEST_TIMEOUT_SECONDS=3600
QWEN3_EMBEDDING_IMAGE=lig/qwen3-embedding-tei:0.6b-1
QWEN3_EMBEDDING_ADAPTER_IMAGE=lig/qwen3-embedding-adapter:0.6b-1
QWEN3_EMBEDDING_PORT=127.0.0.1:42317

# 격리 worker 3개가 페이지 범위 작업 3개를 병렬 처리합니다.
# worker당 task/parser 값을 1로 유지하십시오. 세 값을 모두 3으로 지정하면
# 총 3개가 아니라 최대 9개 파서가 동시에 실행됩니다.
TASK_EXECUTOR_WORKERS=3
MAX_CONCURRENT_TASKS=1
MAX_CONCURRENT_CHUNK_BUILDERS=1
# 한 문서 작업이 동시에 보낼 임베딩 요청 수입니다. qwen3-embedding-tei의
# --max-batch-requests와 맞추십시오. 이보다 작으면 TEI가 배치를 기다리면서도
# 병렬 처리 이점은 얻지 못합니다.
# 12 CPU 환경에서 텍스트 4개짜리 요청 16회를 측정한 결과:
#   1 -> 80.94s   2 -> 93.20s   4 -> 11.36s   6 -> 11.35s   8 -> 12.59s
# 2에서 4로 올릴 때 성능이 크게 개선됐고 6 이상은 이득이 없었습니다.
# 재빌드 없이 순차 처리로 되돌리려면 1로 설정하십시오.
MAX_CONCURRENT_EMBEDDERS=4
TASK_LEASE_SECONDS=180
TASK_MAX_CRASH_RETRIES=0
# 화면의 문서 처리 로그는 DB LONGTEXT에 저장합니다. 문서별 최근 4 MiB와
# task별 최근 256 KiB를 유지하며 필요하면 아래 값을 더 키울 수 있습니다.
DOC_PROGRESS_MSG_MAX_BYTES=4194304
TASK_MAX_LOG_LENGTH=262144
# 협력 취소를 지원하는 파서는 정상적으로 중단됩니다. 네이티브/외부 파서가
# 취소 신호를 무시하면 이 유예시간 뒤 격리 실행기만 재시작하여 다음 작업이
# 막히지 않게 합니다.
TASK_CANCEL_GRACE_SECONDS=5
TASK_CANCEL_POLL_SECONDS=1
TASK_PENDING_CLAIM_IDLE_SECONDS=300
LIG_INGESTION_MEMORY_PERCENT=25
LIG_INGESTION_MEMORY_RESERVE_BYTES=1073741824
LIG_PDF_ESTIMATED_WORKING_BYTES_PER_PAGE=100663296
# DeepDOC, Plain Text, Docling 등 페이지 분할이 가능한 모든 PDF 파서의
# 전역 기본 작업 페이지 수를 40쪽으로 고정합니다. 데이터셋 task_page_size가
# 있으면 그 값이 우선하고, PaddleOCR에는 전송 상한이 추가로 적용됩니다.
# One, 지식 그래프, 목차 추출처럼 전체 문서가 필요한 모드는 분할하지 않습니다.
# 메모리에 따라 자동으로 줄이려면 아래 값을 true로 변경하십시오.
PDF_TASK_PAGE_SIZE=40
ADAPTIVE_PDF_TASK_PAGE_SIZE=false
# 임베딩 요청 하나에 넣을 텍스트 수입니다. 처리량은 개별 요청 크기보다
# MAX_CONCURRENT_EMBEDDERS의 영향을 받습니다. 측정 근거가 없다면 유지하십시오.
# 이 값을 올리면 qwen3-embedding-tei의 --max-batch-tokens도 올려야 하며,
# 시작 시 메모리 할당량만 불필요하게 커질 수 있습니다.
EMBEDDING_BATCH_SIZE=4
# 어댑터는 작업 실행기와 API 서버가 함께 사용하므로 문서 처리 슬롯보다
# 여유가 필요합니다. MAX_CONCURRENT_EMBEDDERS=4이면 문서가 4개를 사용하고
# 남은 2개가 사용자 검색 요청의 대기를 줄입니다. TEI 자체 설정인
# --max-concurrent-requests=8을 넘지 않게 설정하십시오.
EMBEDDING_MAX_CONCURRENT_REQUESTS=6
HUGGINGFACE_EMBEDDING_TIMEOUT_SECONDS=300
HUGGINGFACE_EMBEDDING_MAX_RETRIES=0
HUGGINGFACE_EMBEDDING_QUERY_MAX_RETRIES=3
# 0은 HTTP/파서 크기 상한을 사용하지 않는다는 뜻입니다. 큰 문서를 거부하는
# 대신 자원 적응형 페이지 분할과 역압력으로 실행 환경을 보호합니다.
MAX_CONTENT_LENGTH=0
QUART_BODY_TIMEOUT=0
LIG_DOCUMENT_MAX_BYTES=0
PADDLEOCR_MAX_UPLOAD_BYTES=0
PADDLEOCR_JOB_WORKERS=1
# PaddleOCR 전송 작업에만 적용되는 상한입니다. 기본값에서는 40쪽을 그대로
# 사용하며 ADAPTIVE_PDF_TASK_PAGE_SIZE=true일 때만 메모리에 맞춰 낮춥니다.
PADDLEOCR_TASK_PAGE_SIZE=40
PADDLEOCR_MAX_PDF_PAGES=0
PADDLEOCR_ESTIMATED_BYTES_PER_PIXEL=48
PADDLEOCR_MEMORY_POLL_SECONDS=2
USE_DOCLING=false
REGISTER_ENABLED=1
