# LIG single-node deployment profile.
# Load after docker/.env so these values override the upstream defaults.
RAGFLOW_IMAGE=lig/ragflow-ui:v0.26.4-2
RAGFLOW_GPU_IMAGE=lig/ragflow-ui-gpu:v0.26.4-2
DOC_ENGINE=infinity
DEVICE=cpu
COMPOSE_PROFILES=infinity,cpu
# LIG document-password and resilient OCR/chunking extensions run in the
# Python API and task executor. The upstream Go/hybrid modes remain available
# when explicitly selected, but do not provide the complete LIG extension set.
API_PROXY_SCHEME=python
TZ=Asia/Seoul

# Keep every published service on the local machine only.
SVR_WEB_HTTP_PORT=127.0.0.1:42300
SVR_HTTP_PORT=127.0.0.1:42301
ADMIN_SVR_HTTP_PORT=127.0.0.1:42302
SVR_MCP_PORT=127.0.0.1:42303
GO_ADMIN_PORT=127.0.0.1:42304
GO_HTTP_PORT=127.0.0.1:42305
RAGFLOW_MCP_LIG_PORT=127.0.0.1:42306
SVR_WEB_HTTPS_PORT=127.0.0.1:42307
EXPOSE_MYSQL_PORT=127.0.0.1:42308
MINIO_PORT=127.0.0.1:42309
MINIO_CONSOLE_PORT=127.0.0.1:42310
REDIS_PORT=127.0.0.1:42311
INFINITY_THRIFT_PORT=127.0.0.1:42312
INFINITY_HTTP_PORT=127.0.0.1:42313
INFINITY_PSQL_PORT=127.0.0.1:42314
RAGFLOW_MCP_LIG_IMAGE=lig/ragflow-mcp:v0.26.4-2
LIG_MCP_DATA_DIRECTORY=../../LIG-Deployment/mcp-files
PADDLEOCR_IMAGE=lig/paddleocr-ko:v0.26.4-2
PADDLEOCR_GPU_IMAGE=lig/paddleocr-ko-gpu:v0.26.4-2
PADDLEOCR_PORT=127.0.0.1:42316
QWEN3_EMBEDDING_IMAGE=lig/qwen3-embedding-tei:0.6b-1
QWEN3_EMBEDDING_ADAPTER_IMAGE=lig/qwen3-embedding-adapter:0.6b-1
QWEN3_EMBEDDING_PORT=127.0.0.1:42317

# Workers parallelize queued document tasks. They do not make every page of one
# large PDF run in parallel, and each worker can load parser models into memory.
TASK_EXECUTOR_WORKERS=2
# Local Qwen3 CPU inference must finish each RAGFlow request inside the
# LIG HuggingFace provider's 60-second timeout. This changes only
# request granularity; it does not cap CPU or memory resources.
EMBEDDING_BATCH_SIZE=2
# Keep upload, task parsing, Go API, and OCR service limits aligned at 1 GiB.
MAX_CONTENT_LENGTH=1073741824
PADDLEOCR_MAX_UPLOAD_BYTES=1073741824
PADDLEOCR_JOB_WORKERS=1
PADDLEOCR_TASK_PAGE_SIZE=12
USE_DOCLING=false
REGISTER_ENABLED=1
