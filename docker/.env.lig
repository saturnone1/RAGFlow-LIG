# LIG lightweight single-node profile for a 16 GB Windows laptop.
# Load after docker/.env so these values override the upstream defaults.
DOC_ENGINE=infinity
DEVICE=cpu
COMPOSE_PROFILES=infinity,cpu
TZ=Asia/Seoul

# Keep every published service on the local machine only.
SVR_WEB_HTTP_PORT=127.0.0.1:8080
SVR_WEB_HTTPS_PORT=127.0.0.1:8443
SVR_HTTP_PORT=127.0.0.1:9380
ADMIN_SVR_HTTP_PORT=127.0.0.1:9381
SVR_MCP_PORT=127.0.0.1:9382
GO_HTTP_PORT=127.0.0.1:9384
GO_ADMIN_PORT=127.0.0.1:9383
EXPOSE_MYSQL_PORT=127.0.0.1:13306
MINIO_PORT=127.0.0.1:19000
MINIO_CONSOLE_PORT=127.0.0.1:19001
REDIS_PORT=127.0.0.1:16379
INFINITY_THRIFT_PORT=127.0.0.1:23817
INFINITY_HTTP_PORT=127.0.0.1:23820
INFINITY_PSQL_PORT=127.0.0.1:15432
OLLAMA_PORT=127.0.0.1:11434
OLLAMA_IMAGE=ollama/ollama:0.32.0
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Avoid large concurrent parsing/embedding bursts on a laptop.
DOC_BULK_SIZE=1
EMBEDDING_BATCH_SIZE=4
THREAD_POOL_MAX_WORKERS=8
USE_DOCLING=false
REGISTER_ENABLED=1
